# Copy file này thành .env rồi điền key thật.
# Chỉ cần 1 trong các key dưới đây, tùy LLM bạn chọn trong code.

# Claude (Anthropic) — dùng trong các ví dụ của project này
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Gemini (Google) — nếu muốn dùng ChatGoogle
# GOOGLE_API_KEY=xxxxxxxxxxxxxxxx

# Model tối ưu sẵn của browser-use — nếu dùng ChatBrowserUse()
# BROWSER_USE_API_KEY=xxxxxxxxxxxxxxxx
