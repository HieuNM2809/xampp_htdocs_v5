{
  "name": "02 Health Check & Alert",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "a2b1c0d0-1111-4000-8000-000000000001",
      "name": "Every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 220]
    },
    {
      "parameters": {},
      "id": "a2b1c0d0-2222-4000-8000-000000000002",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 400]
    },
    {
      "parameters": {
        "url": "https://httpbin.org/status/200",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 5000
        }
      },
      "id": "a2b1c0d0-3333-4000-8000-000000000003",
      "name": "Probe URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 310]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "a2b1c0d0-4444-4000-8000-000000000004",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a2b1c0d0-5555-4000-8000-000000000005",
      "name": "Is 200?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 310]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a2b1c0d0-6666-4000-8000-000000000006",
              "name": "status",
              "value": "ok",
              "type": "string"
            },
            {
              "id": "a2b1c0d0-7777-4000-8000-000000000007",
              "name": "checkedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "a2b1c0d0-8888-4000-8000-000000000008",
              "name": "statusCode",
              "value": "={{ $json.statusCode }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "a2b1c0d0-9999-4000-8000-000000000009",
      "name": "OK",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [940, 220]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a2b1c0d0-aaaa-4000-8000-00000000000a",
              "name": "status",
              "value": "alert",
              "type": "string"
            },
            {
              "id": "a2b1c0d0-bbbb-4000-8000-00000000000b",
              "name": "checkedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "a2b1c0d0-cccc-4000-8000-00000000000c",
              "name": "statusCode",
              "value": "={{ $json.statusCode || 0 }}",
              "type": "number"
            },
            {
              "id": "a2b1c0d0-dddd-4000-8000-00000000000d",
              "name": "reason",
              "value": "=Probe returned {{ $json.statusCode || 'no response' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a2b1c0d0-eeee-4000-8000-00000000000e",
      "name": "ALERT",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [940, 400]
    }
  ],
  "connections": {
    "Every 5 min": {
      "main": [
        [
          {
            "node": "Probe URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Probe URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Probe URL": {
      "main": [
        [
          {
            "node": "Is 200?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is 200?": {
      "main": [
        [
          {
            "node": "OK",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "ALERT",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": []
}
